{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buffer",
  "version": "0.4.14",
  "identifier": "dev.wheatlay.buffer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Buffer",
        "width": 1400,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 680,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#121316"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Wheatlay",
    "shortDescription": "Always-on clip recorder and editor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../target/release/buffer-recorder.exe": "buffer-recorder.exe",
      "../vendor/ffmpeg/FFMPEG-LICENSE.txt": "FFMPEG-LICENSE.txt",
      "../helpers/fans/dist/buffer-fans.zip": "buffer-fans.zip",
      "../LICENSE": "LICENSE.txt",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Polish",
          "German",
          "Spanish",
          "French",
          "Ukrainian",
          "Turkish",
          "Japanese",
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "customLanguageFiles": {
          "English": "windows/English.nsh",
          "Polish": "windows/Polish.nsh",
          "German": "windows/German.nsh",
          "Spanish": "windows/Spanish.nsh",
          "French": "windows/French.nsh",
          "Ukrainian": "windows/Ukrainian.nsh",
          "Turkish": "windows/Turkish.nsh",
          "Japanese": "windows/Japanese.nsh",
          "SimpChinese": "windows/SimpChinese.nsh"
        },
        "template": "windows/installer.nsi",
        "compression": "lzma"
      }
    },
    "copyright": "Copyright (c) 2026 Wheatlay"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDOTQ5MzlGMUM5M0U5RkQKUldUOTZaTWNuNU9VVEF6dTBUa3BiV3dSeGN5VXcwS3dSR2JnSmFtaEhFUDVEYm1CZjNTRW1rdGkK",
      "endpoints": [
        "https://github.com/Wheatlay/Buffer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
